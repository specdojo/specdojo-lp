---
import BaseLayout from "../layouts/BaseLayout.astro";

// 構成と原稿は PJR-HEPK。マスコットの絵は PJR-FSMC で扱い、ここでは配置場所の仮の枠だけを置く。
const docsBase = "https://specdojo.github.io/specdojo/ja/";
const quickStartUrl = `${docsBase}specdojo/guides/quick-start-guide.html`;
const registerGuideUrl = `${docsBase}specdojo/guides/register-operation-guide.html`;
const commandReferenceUrl = `${docsBase}specdojo/references/command-reference.html`;
const overviewGuideUrl = `${docsBase}specdojo/guides/specdojo-overview-guide.html`;
const directoryLayoutUrl = `${docsBase}specdojo/references/directory-layout-reference.html`;

const problems = [
  {
    title: "判断が散らばっている",
    body: "チャット、会議メモ、チケットに決めたことが分かれていて、どれが最新か分からない。",
  },
  {
    title: "「なぜ」をたどれない",
    body: "仕様書にはこう書いてあるのに、なぜそう決めたのか、誰も思い出せない。",
  },
  {
    title: "AI に前提を渡せない",
    body: "AI に作業を頼むたびに、背景や決まりごとを一から説明し直している。",
  },
];

type ToolFitRow = {
  situation: string;
  tool: string;
  relationship: string;
};

const toolFitRows: ToolFitRow[] = [
  {
    situation: "チームで課題を議論し、通知で共有したい",
    tool: "GitHub Issues",
    relationship: "補完。issue を、agent に渡せる完了条件つきの todo へ落とすところで register を使う",
  },
  {
    situation: "目の前のタスクの段取りを AI と決めたい",
    tool: "agent の plan（Claude Code・Codex の plan mode）",
    relationship: "補完。plan は段取り、register は「何をなぜ決めたか」を長く残す",
  },
  {
    situation: "1 つの機能を仕様から実装まで素早く作りたい",
    tool: "Spec Kit（新規開発）、OpenSpec（既存コードへの変更）、Kiro（IDE の中で承認しながら）",
    relationship: "工程が違う。SpecDojo はその上流で、プロダクトの要求・仕様を決めて保つ",
  },
  {
    situation: "多数の AI agent に作業を配り、並行して大量に回したい",
    tool: "Beads / Gas Town",
    relationship: "規模と依存関係の管理はあちらが強い。register は判断を残す側",
  },
  {
    situation: "迷い・判断・保留・リスクを、理由ごと残してあとでたどりたい",
    tool: "SpecDojo の register",
    relationship: "いま使える",
  },
  {
    situation: "決めたことを要求・要件・仕様の文書に反映し、保ち続けたい",
    tool: "SpecDojo（型と品質評価）",
    relationship: "準備中。PJR-7T8X の「これから」とつながる",
  },
];

const toolSources = [
  { title: "GitHub Issues", href: "https://docs.github.com/en/issues" },
  {
    title: "Claude Code — Common workflows",
    href: "https://code.claude.com/docs/en/common-workflows",
  },
  {
    title: "Codex — Exec plans",
    href: "https://developers.openai.com/cookbook/articles/codex_exec_plans",
  },
  { title: "Spec Kit", href: "https://github.com/github/spec-kit" },
  { title: "OpenSpec", href: "https://github.com/Fission-AI/OpenSpec" },
  { title: "Kiro", href: "https://kiro.dev/" },
  { title: "Beads", href: "https://github.com/gastownhall/beads" },
  { title: "Gas Town", href: "https://github.com/gastownhall/gastown" },
];

// register の 7 種類。最初の一歩として入りやすい todo を先頭にし、先頭の 3 種類を大きく見せる。
// 各説明は pjr-rulebook の item_type 別終端基準と登録簿運用ガイドの種類の表に合わせる。
type RegisterType = {
  type: string;
  title: string;
  body: string;
};

const primaryRegisterTypes: RegisterType[] = [
  {
    type: "todo",
    title: "やること",
    body: "実施が決まっている作業を、完了条件とやった結果とともに記録します。まずはここから始めます。",
  },
  {
    type: "decision",
    title: "選択肢から方針を決める",
    body: "検討した選択肢、決めたこと、決めた理由と影響を記録します。",
  },
  {
    type: "issue",
    title: "解決すべき問題",
    body: "すでに起きている問題を、解決の内容と確認の結果まで記録します。",
  },
];

const secondaryRegisterTypes: RegisterType[] = [
  {
    type: "question",
    title: "判断を保留し、後で決める",
    body: "回答や確認が必要なことを残し、回答が出たら記録します。",
  },
  {
    type: "risk",
    title: "将来の不確実性",
    body: "まだ起きていない懸念を、消えるか対応を終えるまで追います。",
  },
  {
    type: "change-request",
    title: "合意済みの範囲の変更要求",
    body: "成果物・仕様・計画への変更の要望を、反映と確認まで追います。",
  },
  {
    type: "note",
    title: "記録として残す",
    body: "観測や分析を残します。終わらせず、新しい事実を書き足していきます。",
  },
];

const prerequisites = [
  {
    title: "Node.js 22.13 以上",
    body: "SpecDojo の CLI は npm で導入します。Git も使える状態にしておきます。",
  },
  {
    title: "Claude Code の導入とログイン",
    body: "会話で始める場合に必要です。npm run orch:opus は specdojo orchestrator launch --provider claude を経由して claude を起動します。コマンドで始める場合は不要です。",
  },
];

const orchestratorGuideUrl = `${docsBase}specdojo/guides/orchestrator-operation-guide.html`;

// 「始める」の会話例は specdojo の README「会話で操作する」に合わせる。
type DialogLine = {
  speaker: "you" | "orchestrator";
  text: string;
  code?: string[];
};

type ConversationStep = {
  title: string;
  body: string;
  code?: string[];
  dialog?: DialogLine[];
  providers?: boolean;
};

type CommandStep = {
  title: string;
  body: string;
  code?: string[];
};

const installCode = [
  "mkdir app1-workspace",
  "mkdir app1-workspace/app1-specdojo",
  "git -C app1-workspace/app1-specdojo init",
  "cd app1-workspace/app1-specdojo",
  "npm init -y",
  "npm install --save-dev specdojo",
  "npx specdojo config init",
];

const installStep = {
  title: "SpecDojo を導入する",
  body: "プロジェクト用のリポジトリを作り、SpecDojo を開発用の依存として入れます。config init は、register だけを使う最小の設定（プロジェクト ID は prj-0001）を .specdojo/specdojo.config.json に作ります。",
  code: installCode,
};

const conversationSteps: ConversationStep[] = [
  installStep,
  {
    title: "オーケストレーターを配置する",
    body: "SpecDojo には、会話を CLI の操作に置き換えてくれる対話型オーケストレーターが入っています。使う AI ツール（provider）の設定を配置します。次は Claude Code の例です。package.json に起動用の script が追加されます。",
    code: ["npx specdojo config scaffold --provider claude"],
  },
  {
    title: "オーケストレーターを起動する",
    body: "追加された script で起動します。ほかの provider を使う場合は、config scaffold の --provider を変えて配置し、次の script で起動します。",
    code: ["npm run orch:opus"],
    providers: true,
  },
  {
    title: "最初の作業を起票する",
    body: "やりたいことを、そのまま伝えます。オーケストレーターがコマンドに置き換え、実行する前に内容を見せて確認を求めます。",
    dialog: [
      {
        speaker: "you",
        text: "このプロジェクトを始めたい。まず登録簿を用意して、最初の作業を todo として起票して。",
      },
      {
        speaker: "orchestrator",
        text: "次を実行します。よろしいですか。",
        code: [
          "npx specdojo register scaffold --project prj-0001",
          'npx specdojo register add --project prj-0001 --type todo --title "..."',
        ],
      },
      { speaker: "you", text: "お願いします。" },
    ],
  },
  {
    title: "一覧を作る",
    body: "起票した項目は、個票（Markdown）として保存されます。一覧づくりも同じように頼めます。「今の状況は？」と聞けば、状況の確認もできます。",
    dialog: [
      { speaker: "you", text: "一覧を作って。" },
      {
        speaker: "orchestrator",
        text: "次を実行します。よろしいですか。",
        code: ["npx specdojo register build --project prj-0001"],
      },
      { speaker: "you", text: "お願いします。" },
    ],
  },
];

const commandSteps: CommandStep[] = [
  installStep,
  {
    title: "オーケストレーターを配置する",
    body: "コマンドで進める場合は不要です（会話で進める場合だけの手順です）。",
  },
  {
    title: "オーケストレーターを起動する",
    body: "コマンドで進める場合は不要です（会話で進める場合だけの手順です）。",
  },
  {
    title: "最初の作業を起票する",
    body: "登録簿の置き場所と一覧を作り、最初の作業を todo として起票します。表示された PJR-XXXX の個票（Markdown）を開き、背景や完了条件を書き足します。",
    code: [
      "npx specdojo register scaffold --project prj-0001",
      'npx specdojo register add --project prj-0001 --type todo --title "最初のタスク"',
    ],
  },
  {
    title: "一覧を作る",
    body: "個票から一覧とログを作り直します。controls/project-register/generated/pjr-index.md を開くと、起票した項目が並んでいます。",
    code: ["npx specdojo register build --project prj-0001"],
  },
];

const providerScripts = [
  { provider: "claude（Claude Code）", script: "npm run orch:opus（orch:sonnet も追加されます）" },
  { provider: "opencode", script: "npm run orch:opencode" },
  { provider: "codex", script: "npm run orch:codex" },
  { provider: "antigravity", script: "npm run orch:agy" },
];

const speakerLabels = {
  you: "あなた",
  orchestrator: "オーケストレーター",
} as const;

const nextLinks = [
  {
    title: "Quick Start ガイド",
    body: "question を起票し、decision で決め、仕様書に書き、change-request で直すまでの流れを 10 分ほどで体験します。",
    href: quickStartUrl,
  },
  {
    title: "登録簿運用ガイド",
    body: "todo・decision・issue をはじめとする 7 つの種類と、それぞれの状態の進め方を確認します。",
    href: registerGuideUrl,
  },
  {
    title: "CLI コマンドリファレンス",
    body: "register をはじめ、すべてのコマンドとオプションを調べられます。",
    href: commandReferenceUrl,
  },
  {
    title: "全体概要ガイド",
    body: "成果物カタログ、schedule、AI による実行まで、SpecDojo の全体像をつかみます。",
    href: overviewGuideUrl,
  },
];
---

<BaseLayout
  title="SpecDojo — 記して、形にして、磨き続ける。"
  description="SpecDojo は、迷っていることを記帳し、決めたことを要求・要件・仕様へ形にし、後日の変更も同じ台帳に残すための CLI です。いつでも、どこからでも始められ、使うほど育ちます。"
>
  <header class="bg-surface-container px-6 py-4">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-4">
      <a href="/" class="text-title-large text-on-surface">SpecDojo</a>
      <a
        href={docsBase}
        class="rounded-full px-4 py-2 text-label-large text-primary hover:bg-primary-container"
      >
        ドキュメント
      </a>
    </div>
  </header>

  <main class="mx-auto max-w-5xl px-6 py-16">
    <section
      class="grid items-center gap-10 rounded-extra-large bg-primary-container p-10 shadow-elevation-1 md:grid-cols-[3fr_2fr]"
    >
      <div>
        <p class="text-label-large text-on-primary-container">仕様の判断台帳</p>
        <h1 class="mt-2 text-display-small text-on-primary-container md:text-display-medium">
          記して、形にして、磨き続ける。
        </h1>
        <p class="mt-4 text-body-large text-on-primary-container">
          SpecDojo は、迷っていることを記帳し、決めたことを要求・要件・仕様へ形にし、後日の変更も同じ台帳に残すための
          CLI です。いつでも、どこからでも小さく始められ、記録は使うほど育ちます。すべて Markdown なので、Git でそのまま読めます。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#start"
            class="inline-flex items-center rounded-full bg-primary px-6 py-2.5 text-label-large text-on-primary shadow-elevation-1 hover:shadow-elevation-2"
          >
            5 つの手順で始める
          </a>
          <a
            href={quickStartUrl}
            class="inline-flex items-center rounded-full border border-outline px-6 py-2.5 text-label-large text-primary hover:bg-surface-container-low"
          >
            Quick Start を読む
          </a>
        </div>
      </div>
      <div
        data-placeholder="mascot"
        class="flex aspect-square items-center justify-center rounded-extra-large border-2 border-dashed border-outline bg-surface-container-lowest"
      >
        <p class="text-label-large text-on-surface-variant">マスコット（準備中）</p>
      </div>
    </section>

    <section id="problems" class="mt-20">
      <h2 class="text-headline-medium text-on-surface">こんなことはありませんか</h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {
          problems.map((problem) => (
            <li class="rounded-medium bg-surface-container-low p-6 shadow-elevation-1">
              <h3 class="text-title-medium text-on-surface">{problem.title}</h3>
              <p class="mt-2 text-body-medium text-on-surface-variant">{problem.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-body-large text-on-surface">
        SpecDojo は、判断とその理由を 1 つの台帳に集めます。仕様書から台帳の ID をたどれば「なぜこう書いたか」が分かり、同じ台帳を
        AI に渡せば、前提を説明し直す手間も減ります。
      </p>
    </section>

    <section id="register" class="mt-20">
      <h2 class="text-headline-medium text-on-surface">register の考え方</h2>
      <p class="mt-4 text-body-large text-on-surface">
        register（登録簿）は、プロジェクトで起きたことを 1 件ずつ起票して記録を集める台帳です。種類は 7 つあります。まずは todo
        から始め、慣れたら decision と issue を使いましょう。
      </p>
      <ul class="mt-6 grid gap-6 md:grid-cols-3">
        {
          primaryRegisterTypes.map((item) => (
            <li class="rounded-medium bg-surface-container-low p-6 shadow-elevation-1">
              <p class="text-label-large text-primary">{item.type}</p>
              <h3 class="mt-1 text-title-large text-on-surface">{item.title}</h3>
              <p class="mt-2 text-body-medium text-on-surface-variant">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
        {
          secondaryRegisterTypes.map((item) => (
            <li class="rounded-small bg-surface-container-low p-4">
              <p class="text-label-medium text-primary">{item.type}</p>
              <h3 class="mt-1 text-title-small text-on-surface">{item.title}</h3>
              <p class="mt-1 text-body-small text-on-surface-variant">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 rounded-large bg-secondary-container p-6">
        <ul class="list-disc space-y-2 pl-5 text-body-medium text-on-secondary-container">
          <li>起票すると、1 件ごとに個票（Markdown）ができます。個票が記録の正本です。</li>
          <li>一覧は個票から生成されます。一覧を手で直す必要はありません。</li>
          <li>個票はただの Markdown なので、SpecDojo がなくても読め、Git で履歴を追えます。</li>
        </ul>
      </div>
    </section>

    <section id="tool-fit" class="mt-20">
      <h2 class="text-headline-medium text-on-surface">何に困ったら、何を使う？</h2>
      <p class="mt-4 text-body-large text-on-surface">
        ツールに優劣をつけるのではなく、いま解きたい困りごとから選びます。SpecDojo はほかのツールを置き換えるものではなく、判断と理由を残す役割で組み合わせられます。
      </p>

      <ul class="mt-6 space-y-4 md:hidden">
        {
          toolFitRows.map((row) => (
            <li class="rounded-medium bg-surface-container-low p-5 shadow-elevation-1">
              <dl class="space-y-4">
                <div>
                  <dt class="text-label-large text-primary">こんなときは</dt>
                  <dd class="mt-1 text-body-medium text-on-surface">{row.situation}</dd>
                </div>
                <div>
                  <dt class="text-label-large text-primary">向いているもの</dt>
                  <dd class="mt-1 text-body-medium text-on-surface">{row.tool}</dd>
                </div>
                <div>
                  <dt class="text-label-large text-primary">SpecDojo との関係</dt>
                  <dd class="mt-1 text-body-medium text-on-surface-variant">{row.relationship}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-6 hidden overflow-hidden rounded-large border border-outline-variant shadow-elevation-1 md:block"
      >
        <table class="w-full table-fixed text-left">
          <thead class="bg-primary-container text-on-primary-container">
            <tr>
              <th scope="col" class="w-1/3 px-5 py-4 text-label-large">こんなときは</th>
              <th scope="col" class="w-1/3 px-5 py-4 text-label-large">向いているもの</th>
              <th scope="col" class="w-1/3 px-5 py-4 text-label-large">SpecDojo との関係</th>
            </tr>
          </thead>
          <tbody class="bg-surface">
            {
              toolFitRows.map((row) => (
                <tr class="border-t border-outline-variant">
                  <td class="px-5 py-4 align-top text-body-medium text-on-surface">
                    {row.situation}
                  </td>
                  <td class="px-5 py-4 align-top text-body-medium text-on-surface">{row.tool}</td>
                  <td class="px-5 py-4 align-top text-body-medium text-on-surface-variant">
                    {row.relationship}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-8 rounded-large bg-secondary-container p-6">
        <h3 class="text-title-large text-on-secondary-container">GitHub Issues と register をつなぐ</h3>
        <p class="mt-2 text-body-medium text-on-secondary-container">
          GitHub Issues はチームでの議論、通知、開発者以外からの報告に向いています。そこで話した内容を agent
          が実行できる粒度にするとき、register を使います。
        </p>
        <ol class="mt-5 grid gap-4 md:grid-cols-3">
          <li class="rounded-medium bg-surface-container-lowest p-4 shadow-elevation-1">
            <p class="text-label-large text-primary">1. 議論して共有する</p>
            <p class="mt-2 text-body-medium text-on-surface-variant">
              GitHub Issues で課題を話し合い、通知を使ってチームに共有します。
            </p>
          </li>
          <li class="rounded-medium bg-surface-container-lowest p-4 shadow-elevation-1">
            <p class="text-label-large text-primary">2. todo に落とす</p>
            <p class="mt-2 text-body-medium text-on-surface-variant">
              issue の URL を個票に書いてつなぎ、背景と完了条件のある具体的な todo にします。
            </p>
          </li>
          <li class="rounded-medium bg-surface-container-lowest p-4 shadow-elevation-1">
            <p class="text-label-large text-primary">3. agent に渡す</p>
            <p class="mt-2 text-body-medium text-on-surface-variant">
              完了条件から exec plan を作り、実行する agent に渡します。決めたことは理由ごと残ります。
            </p>
          </li>
        </ol>
        <p class="mt-4 text-body-small text-on-secondary-container">
          GitHub との自動連携ではありません。現時点では、issue の URL を個票に書いてつなぐ形です。
        </p>
      </div>

      <div class="mt-6">
        <p class="text-body-small text-on-surface-variant">
          2026 年 10 月時点の各ツールの公開情報による。
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-body-small">
          {
            toolSources.map((source) => (
              <li>
                <a href={source.href} class="text-primary underline">{source.title}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="start" class="mt-20">
      <h2 class="text-headline-medium text-on-surface">5 つの手順で始める</h2>
      <p class="mt-4 text-body-large text-on-surface">
        導入したら、あとはやりたいことを会話で伝えるだけです。最初の 1 件を起票して一覧を作るまでを、上から順に試します。
      </p>
      <p class="mt-2 text-body-medium text-on-surface-variant">
        オーケストレーターは、状態を変える操作を承認を得てから実行し、git push や破壊的な操作は行いません。
      </p>

      <div class="mt-6 rounded-large bg-secondary-container p-6">
        <h3 class="text-title-medium text-on-secondary-container">始める前に用意するもの</h3>
        <ul class="mt-3 space-y-3">
          {
            prerequisites.map((item) => (
              <li>
                <p class="text-label-large text-on-secondary-container">{item.title}</p>
                <p class="mt-1 text-body-medium text-on-secondary-container">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="mt-6 rounded-large bg-surface-container-low p-6 shadow-elevation-1">
        <figcaption class="text-title-medium text-on-surface">
          SpecDojo を別リポジトリで使うときの構成
        </figcaption>
        <pre class="mt-4 overflow-x-auto rounded-small bg-inverse-surface p-4 text-body-medium text-inverse-on-surface"><code>{`app1-workspace/
├── app1/                     # プロダクト
├── app1-specdojo/            # SpecDojo の記録
└── app1-specdojo-worktrees/  # exec の作業領域`}</code></pre>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-body-medium text-on-surface-variant">
          <li>register だけなら、まずは <code>app1-specdojo/</code> だけで始められます。</li>
          <li>worktree は、exec でタスクごとの作業を隔離するときに作られます。</li>
          <li>
            配置の考え方と詳しい構成は
            <a href={directoryLayoutUrl} class="text-primary underline">ディレクトリレイアウトリファレンス</a>
            を参照してください。
          </li>
        </ul>
      </figure>

      <div
        data-start-tabs
        role="tablist"
        aria-label="始め方"
        hidden
        class="mt-8 inline-flex gap-1 rounded-full bg-surface-container p-1"
      >
        <button
          type="button"
          role="tab"
          id="start-tab-conversation"
          aria-controls="start-panel-conversation"
          aria-selected="true"
          tabindex="0"
          class="rounded-full px-5 py-2 text-label-large text-on-surface-variant aria-selected:bg-primary aria-selected:text-on-primary"
        >
          会話で始める
        </button>
        <button
          type="button"
          role="tab"
          id="start-tab-command"
          aria-controls="start-panel-command"
          aria-selected="false"
          tabindex="-1"
          class="rounded-full px-5 py-2 text-label-large text-on-surface-variant aria-selected:bg-primary aria-selected:text-on-primary"
        >
          コマンドで始める（参考）
        </button>
      </div>

      <div
        id="start-panel-conversation"
        role="tabpanel"
        aria-labelledby="start-tab-conversation"
        tabindex="0"
        class="mt-6"
      >
        <h3 data-panel-heading class="mb-4 text-title-large text-on-surface">会話で始める</h3>
        <ol class="space-y-6">
          {
            conversationSteps.map((step, index) => (
              <li class="rounded-large bg-surface-container-low p-6 shadow-elevation-1">
                <div class="flex items-baseline gap-3">
                  <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-label-large text-on-primary">
                    {index + 1}
                  </span>
                  <h4 class="text-title-medium text-on-surface">{step.title}</h4>
                </div>
                <p class="mt-3 text-body-medium text-on-surface-variant">{step.body}</p>
                {step.code && (
                  <pre class="mt-4 overflow-x-auto rounded-small bg-inverse-surface p-4 text-body-medium text-inverse-on-surface"><code>{step.code.join("\n")}</code></pre>
                )}
                {step.providers && (
                  <table class="mt-4 w-full text-left text-body-medium text-on-surface-variant">
                    <thead>
                      <tr class="border-b border-outline-variant">
                        <th scope="col" class="py-2 pr-4 text-label-large text-on-surface">provider</th>
                        <th scope="col" class="py-2 text-label-large text-on-surface">起動</th>
                      </tr>
                    </thead>
                    <tbody>
                      {providerScripts.map((row) => (
                        <tr class="border-b border-outline-variant">
                          <td class="py-2 pr-4">{row.provider}</td>
                          <td class="py-2">
                            <code>{row.script}</code>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
                {step.dialog && (
                  <ul class="mt-4 space-y-3">
                    {step.dialog.map((line) => (
                      <li
                        class={
                          line.speaker === "you"
                            ? "ml-auto max-w-[85%] rounded-large bg-primary-container p-4 text-on-primary-container"
                            : "mr-auto max-w-[85%] rounded-large bg-surface-container-highest p-4 text-on-surface"
                        }
                      >
                        <p class="text-label-medium">{speakerLabels[line.speaker]}</p>
                        <p class="mt-1 text-body-medium">{line.text}</p>
                        {line.code && (
                          <pre class="mt-3 overflow-x-auto rounded-small bg-inverse-surface p-3 text-body-small text-inverse-on-surface"><code>{line.code.join("\n")}</code></pre>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>
        <p class="mt-6 text-body-medium text-on-surface-variant">
          起票した項目の実行や成果物の生成も、同じ流れで進められます。詳しい進め方は
          <a href={orchestratorGuideUrl} class="text-primary underline">オーケストレーター運用ガイド</a>
          を参照してください。
        </p>
      </div>

      <div
        id="start-panel-command"
        role="tabpanel"
        aria-labelledby="start-tab-command"
        tabindex="0"
        class="mt-6"
      >
        <h3 data-panel-heading class="mb-4 text-title-large text-on-surface">コマンドで始める（参考）</h3>
        <ol class="space-y-6">
          {
            commandSteps.map((step, index) => (
              <li class="rounded-large bg-surface-container-low p-6 shadow-elevation-1">
                <div class="flex items-baseline gap-3">
                  <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-label-large text-on-primary">
                    {index + 1}
                  </span>
                  <h4 class="text-title-medium text-on-surface">{step.title}</h4>
                </div>
                <p class="mt-3 text-body-medium text-on-surface-variant">{step.body}</p>
                {step.code && (
                  <pre class="mt-4 overflow-x-auto rounded-small bg-inverse-surface p-4 text-body-medium text-inverse-on-surface"><code>{step.code.join("\n")}</code></pre>
                )}
              </li>
            ))
          }
        </ol>
        <p class="mt-6 text-body-medium text-on-surface-variant">
          オーケストレーターを使わずに、CLI を直接実行することもできます。各コマンドの詳しいオプションは
          <a href={commandReferenceUrl} class="text-primary underline">CLI コマンドリファレンス</a>
          を参照してください。
        </p>
      </div>

      <p class="mt-6 text-body-medium text-on-surface-variant">
        作成された設定と個票を確認して commit すれば完了です。
      </p>

      {/* JavaScript が無効な環境では、タブを出さずに両方の内容を表示する。 */}
      <script is:inline>
        (() => {
          const tablist = document.querySelector("[data-start-tabs]");
          if (!tablist) return;
          const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
          const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")));
          const select = (selectedIndex, shouldFocus) => {
            tabs.forEach((tab, index) => {
              const isSelected = index === selectedIndex;
              tab.setAttribute("aria-selected", String(isSelected));
              tab.tabIndex = isSelected ? 0 : -1;
              const panel = panels[index];
              if (panel) panel.hidden = !isSelected;
            });
            if (shouldFocus) tabs[selectedIndex].focus();
          };
          tabs.forEach((tab, index) => {
            tab.addEventListener("click", () => select(index, false));
            tab.addEventListener("keydown", (event) => {
              const last = tabs.length - 1;
              const next =
                event.key === "ArrowRight"
                  ? (index + 1) % tabs.length
                  : event.key === "ArrowLeft"
                    ? (index + last) % tabs.length
                    : event.key === "Home"
                      ? 0
                      : event.key === "End"
                        ? last
                        : -1;
              if (next < 0) return;
              event.preventDefault();
              select(next, true);
            });
          });
          document.querySelectorAll("[data-panel-heading]").forEach((heading) => {
            heading.hidden = true;
          });
          tablist.hidden = false;
          select(0, false);
        })();
      </script>
    </section>

    <section id="next" class="mt-20">
      <h2 class="text-headline-medium text-on-surface">次の一歩</h2>
      <p class="mt-4 text-body-large text-on-surface">
        起票に慣れたら、decision で決め、仕様書に書き、change-request で直す流れへ進みましょう。詳しくはドキュメントサイトで案内しています。
      </p>
      <ul class="mt-6 grid gap-6 md:grid-cols-2">
        {
          nextLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="block h-full rounded-medium bg-surface-container-low p-6 shadow-elevation-1 hover:shadow-elevation-2"
              >
                <h3 class="text-title-medium text-primary">{link.title}</h3>
                <p class="mt-2 text-body-medium text-on-surface-variant">{link.body}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer class="border-t border-outline-variant px-6 py-8">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4">
      <p class="text-body-small text-on-surface-variant">© SpecDojo</p>
      <a href={docsBase} class="text-body-small text-primary underline">ドキュメントサイト</a>
    </div>
  </footer>
</BaseLayout>
