---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import GetStarted from "../components/sections/GetStarted.astro";
import Hero from "../components/sections/Hero.astro";
import NextSteps from "../components/sections/NextSteps.astro";
import Problems from "../components/sections/Problems.astro";
import RegisterTypes from "../components/sections/RegisterTypes.astro";
import Roadmap from "../components/sections/Roadmap.astro";
import ToolFit from "../components/sections/ToolFit.astro";
---

<BaseLayout
  title="SpecDojo — 記して、形にして、磨き続ける。"
  description="SpecDojo は、迷っていることを記帳し、決めたことを要求・要件・仕様へ形にし、後日の変更も同じ台帳に残すための CLI です。いつでも、どこからでも始められ、使うほど育ちます。"
>
  <SiteHeader />
  <main class="mx-auto max-w-5xl px-6 py-16">
    <Hero />
    <Problems />
    <RegisterTypes />
    <ToolFit />
    <GetStarted />
    <NextSteps />
    <Roadmap />
  </main>
  <SiteFooter />
</BaseLayout>
