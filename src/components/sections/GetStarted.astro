---
import Tabs from "../Tabs.astro";
import {
  commandReferenceUrl,
  directoryLayoutUrl,
  orchestratorGuideUrl,
} from "../../lib/links";

type Prerequisite = {
  title: string;
  body: string;
};

type DialogLine = {
  speaker: "you" | "orchestrator";
  text: string;
  code?: string[];
};

type ConversationStep = {
  title: string;
  body: string;
  code?: string[];
  dialog?: DialogLine[];
  providers?: boolean;
};

type CommandStep = {
  title: string;
  body: string;
  code?: string[];
};

const prerequisites: Prerequisite[] = [
  {
    title: "Node.js 22.13 以上",
    body: "SpecDojo の CLI は npm で導入します。Git も使える状態にしておきます。",
  },
  {
    title: "Claude Code の導入とログイン",
    body: "会話で始める場合に必要です。npm run orch:opus は specdojo orchestrator launch --provider claude を経由して claude を起動します。コマンドで始める場合は不要です。",
  },
];

const installCode = [
  "mkdir app1-workspace",
  "mkdir app1-workspace/app1-specdojo",
  "git -C app1-workspace/app1-specdojo init",
  "cd app1-workspace/app1-specdojo",
  "npm init -y",
  "npm install --save-dev specdojo",
  "npx specdojo config init",
];

const installStep = {
  title: "SpecDojo を導入する",
  body: "プロジェクト用のリポジトリを作り、SpecDojo を開発用の依存として入れます。config init は、register だけを使う最小の設定（プロジェクト ID は prj-0001）を .specdojo/specdojo.config.json に作ります。",
  code: installCode,
};

// 「始める」の会話例は specdojo の README「会話で操作する」に合わせる。
const conversationSteps: ConversationStep[] = [
  installStep,
  {
    title: "オーケストレーターを配置する",
    body: "SpecDojo には、会話を CLI の操作に置き換えてくれる対話型オーケストレーターが入っています。使う AI ツール（provider）の設定を配置します。次は Claude Code の例です。package.json に起動用の script が追加されます。",
    code: ["npx specdojo config scaffold --provider claude"],
  },
  {
    title: "オーケストレーターを起動する",
    body: "追加された script で起動します。ほかの provider を使う場合は、config scaffold の --provider を変えて配置し、次の script で起動します。",
    code: ["npm run orch:opus"],
    providers: true,
  },
  {
    title: "最初の作業を起票する",
    body: "やりたいことを、そのまま伝えます。オーケストレーターがコマンドに置き換え、実行する前に内容を見せて確認を求めます。",
    dialog: [
      {
        speaker: "you",
        text: "このプロジェクトを始めたい。まず登録簿を用意して、最初の作業を todo として起票して。",
      },
      {
        speaker: "orchestrator",
        text: "次を実行します。よろしいですか。",
        code: [
          "npx specdojo register scaffold --project prj-0001",
          'npx specdojo register add --project prj-0001 --type todo --title "..."',
        ],
      },
      { speaker: "you", text: "お願いします。" },
    ],
  },
  {
    title: "一覧を作る",
    body: "起票した項目は、個票（Markdown）として保存されます。一覧づくりも同じように頼めます。「今の状況は？」と聞けば、状況の確認もできます。",
    dialog: [
      { speaker: "you", text: "一覧を作って。" },
      {
        speaker: "orchestrator",
        text: "次を実行します。よろしいですか。",
        code: ["npx specdojo register build --project prj-0001"],
      },
      { speaker: "you", text: "お願いします。" },
    ],
  },
];

const commandSteps: CommandStep[] = [
  installStep,
  {
    title: "オーケストレーターを配置する",
    body: "コマンドで進める場合は不要です（会話で進める場合だけの手順です）。",
  },
  {
    title: "オーケストレーターを起動する",
    body: "コマンドで進める場合は不要です（会話で進める場合だけの手順です）。",
  },
  {
    title: "最初の作業を起票する",
    body: "登録簿の置き場所と一覧を作り、最初の作業を todo として起票します。表示された PJR-XXXX の個票（Markdown）を開き、背景や完了条件を書き足します。",
    code: [
      "npx specdojo register scaffold --project prj-0001",
      'npx specdojo register add --project prj-0001 --type todo --title "最初のタスク"',
    ],
  },
  {
    title: "一覧を作る",
    body: "個票から一覧とログを作り直します。controls/project-register/generated/pjr-index.md を開くと、起票した項目が並んでいます。",
    code: ["npx specdojo register build --project prj-0001"],
  },
];

const providerScripts = [
  { provider: "claude（Claude Code）", script: "npm run orch:opus（orch:sonnet も追加されます）" },
  { provider: "opencode", script: "npm run orch:opencode" },
  { provider: "codex", script: "npm run orch:codex" },
  { provider: "antigravity", script: "npm run orch:agy" },
];

const speakerLabels = {
  you: "あなた",
  orchestrator: "オーケストレーター",
} as const;
---

<section id="start" class="mt-20">
  <h2 class="text-headline-medium text-on-surface">5 つの手順で始める</h2>
  <p class="mt-4 text-body-large text-on-surface">
    導入したら、あとはやりたいことを会話で伝えるだけです。最初の 1 件を起票して一覧を作るまでを、上から順に試します。
  </p>
  <p class="mt-2 text-body-medium text-on-surface-variant">
    オーケストレーターは、状態を変える操作を承認を得てから実行し、git push や破壊的な操作は行いません。
  </p>

  <div class="mt-6 rounded-large bg-secondary-container p-6">
    <h3 class="text-title-medium text-on-secondary-container">始める前に用意するもの</h3>
    <ul class="mt-3 space-y-3">
      {
        prerequisites.map((item) => (
          <li>
            <p class="text-label-large text-on-secondary-container">{item.title}</p>
            <p class="mt-1 text-body-medium text-on-secondary-container">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <figure class="mt-6 rounded-large bg-surface-container-low p-6 shadow-elevation-1">
    <figcaption class="text-title-medium text-on-surface">
      SpecDojo を別リポジトリで使うときの構成
    </figcaption>
    <pre class="mt-4 overflow-x-auto rounded-small bg-inverse-surface p-4 text-body-medium text-inverse-on-surface"><code>{`app1-workspace/
├── app1/                     # プロダクト
├── app1-specdojo/            # SpecDojo の記録
└── app1-specdojo-worktrees/  # exec の作業領域`}</code></pre>
    <ul class="mt-4 list-disc space-y-2 pl-5 text-body-medium text-on-surface-variant">
      <li>register だけなら、まずは <code>app1-specdojo/</code> だけで始められます。</li>
      <li>worktree は、exec でタスクごとの作業を隔離するときに作られます。</li>
      <li>
        配置の考え方と詳しい構成は
        <a href={directoryLayoutUrl} class="text-primary underline">ディレクトリレイアウトリファレンス</a>
        を参照してください。
      </li>
    </ul>
  </figure>

  <Tabs>
    <Fragment slot="conversation">
      <ol class="space-y-6">
        {
          conversationSteps.map((step, index) => (
            <li class="rounded-large bg-surface-container-low p-6 shadow-elevation-1">
              <div class="flex items-baseline gap-3">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-label-large text-on-primary">
                  {index + 1}
                </span>
                <h4 class="text-title-medium text-on-surface">{step.title}</h4>
              </div>
              <p class="mt-3 text-body-medium text-on-surface-variant">{step.body}</p>
              {step.code && (
                <pre class="mt-4 overflow-x-auto rounded-small bg-inverse-surface p-4 text-body-medium text-inverse-on-surface"><code>{step.code.join("\n")}</code></pre>
              )}
              {step.providers && (
                <table class="mt-4 w-full text-left text-body-medium text-on-surface-variant">
                  <thead>
                    <tr class="border-b border-outline-variant">
                      <th scope="col" class="py-2 pr-4 text-label-large text-on-surface">provider</th>
                      <th scope="col" class="py-2 text-label-large text-on-surface">起動</th>
                    </tr>
                  </thead>
                  <tbody>
                    {providerScripts.map((row) => (
                      <tr class="border-b border-outline-variant">
                        <td class="py-2 pr-4">{row.provider}</td>
                        <td class="py-2">
                          <code>{row.script}</code>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              {step.dialog && (
                <ul class="mt-4 space-y-3">
                  {step.dialog.map((line) => (
                    <li
                      class={
                        line.speaker === "you"
                          ? "ml-auto max-w-[85%] rounded-large bg-primary-container p-4 text-on-primary-container"
                          : "mr-auto max-w-[85%] rounded-large bg-surface-container-highest p-4 text-on-surface"
                      }
                    >
                      <p class="text-label-medium">{speakerLabels[line.speaker]}</p>
                      <p class="mt-1 text-body-medium">{line.text}</p>
                      {line.code && (
                        <pre class="mt-3 overflow-x-auto rounded-small bg-inverse-surface p-3 text-body-small text-inverse-on-surface"><code>{line.code.join("\n")}</code></pre>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-body-medium text-on-surface-variant">
        起票した項目の実行や成果物の生成も、同じ流れで進められます。詳しい進め方は
        <a href={orchestratorGuideUrl} class="text-primary underline">オーケストレーター運用ガイド</a>
        を参照してください。
      </p>
    </Fragment>

    <Fragment slot="command">
      <ol class="space-y-6">
        {
          commandSteps.map((step, index) => (
            <li class="rounded-large bg-surface-container-low p-6 shadow-elevation-1">
              <div class="flex items-baseline gap-3">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary text-label-large text-on-primary">
                  {index + 1}
                </span>
                <h4 class="text-title-medium text-on-surface">{step.title}</h4>
              </div>
              <p class="mt-3 text-body-medium text-on-surface-variant">{step.body}</p>
              {step.code && (
                <pre class="mt-4 overflow-x-auto rounded-small bg-inverse-surface p-4 text-body-medium text-inverse-on-surface"><code>{step.code.join("\n")}</code></pre>
              )}
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-body-medium text-on-surface-variant">
        オーケストレーターを使わずに、CLI を直接実行することもできます。各コマンドの詳しいオプションは
        <a href={commandReferenceUrl} class="text-primary underline">CLI コマンドリファレンス</a>
        を参照してください。
      </p>
    </Fragment>
    <p class="mt-6 text-body-medium text-on-surface-variant">
      作成された設定と個票を確認して commit すれば完了です。
    </p>
  </Tabs>
</section>
