---
type RoadmapPhase = {
  phase: string;
  label: string;
};

type RoadmapRow = {
  name: string;
  status: string;
  available: boolean;
  steps: readonly string[];
};

const roadmapPhases: RoadmapPhase[] = [
  { phase: "Plan", label: "記して" },
  { phase: "Do", label: "形にして" },
  { phase: "Check", label: "磨き続ける（評価）" },
  { phase: "Action", label: "磨き続ける（確定・改善）" },
];

const roadmapRows: RoadmapRow[] = [
  {
    name: "register",
    status: "いま使える",
    available: true,
    steps: [
      "気づいたことを起票する",
      "AI が実行する",
      "人が確かめる",
      "完了として残す。必要なら直す",
    ],
  },
  {
    name: "schedule",
    status: "準備中",
    available: false,
    steps: [
      "作る成果物を計画に並べる",
      "順に実行する",
      "品質を評価し、確かめる",
      "確定して次の反復へ",
    ],
  },
  {
    name: "routine + job",
    status: "準備中",
    available: false,
    steps: [
      "何を・いつ・誰が確かめるかを決める",
      "決まった時刻に自動で実行する",
      "指名した AI が確かめる",
      "合格したものだけ取り込み、続きから再開する",
    ],
  },
];
---

<section id="roadmap" class="mt-20">
  <p class="text-label-large text-primary">今できること、その先へ</p>
  <h2 class="mt-2 text-headline-medium text-on-surface">これから</h2>
  <p class="mt-4 text-body-large text-on-surface">
    SpecDojo
    は、気づきを記すところから始まり、計画や定期的な仕事へ広がっていきます。いま使える
    register と、準備を進めている機能を、同じ 1 周の流れで示します。
  </p>

  <ul class="mt-6 space-y-4 md:hidden">
    {roadmapRows.map((row) => (
      <li class="rounded-large bg-surface-container-low p-5 shadow-elevation-1">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-title-large text-on-surface">{row.name}</h3>
          <span
            class:list={[
              "rounded-full px-3 py-1 text-label-medium",
              row.available
                ? "bg-primary-container text-on-primary-container"
                : "bg-surface-container-highest text-on-surface-variant",
            ]}
          >
            {row.status}
          </span>
        </div>
        <dl class="mt-5 space-y-4">
          {roadmapPhases.map((phase, index) => (
            <div>
              <dt class="text-label-large text-primary">
                {phase.phase}　{phase.label}
              </dt>
              <dd class="mt-1 text-body-medium text-on-surface-variant">
                {row.steps[index]}
              </dd>
            </div>
          ))}
        </dl>
      </li>
    ))}
  </ul>

  <div
    role="table"
    aria-label="SpecDojo のこれからを示す PDCA マトリクス"
    class="mt-6 hidden overflow-hidden rounded-large border border-outline-variant shadow-elevation-1 md:grid md:grid-cols-[minmax(9rem,1fr)_repeat(4,minmax(0,1fr))]"
  >
    <div role="row" class="contents">
      <div role="columnheader" class="bg-primary-container px-4 py-4"></div>
      {roadmapPhases.map((phase) => (
        <div
          role="columnheader"
          class="bg-primary-container px-4 py-4 text-on-primary-container"
        >
          <p class="text-title-medium">{phase.phase}</p>
          <p class="mt-1 text-label-medium">{phase.label}</p>
        </div>
      ))}
    </div>
    {roadmapRows.map((row) => (
      <div role="row" class="contents">
        <div
          role="rowheader"
          class="border-t border-outline-variant bg-surface-container px-4 py-5"
        >
          <p class="text-title-medium text-on-surface">{row.name}</p>
          <span
            class:list={[
              "mt-2 inline-flex rounded-full px-3 py-1 text-label-medium",
              row.available
                ? "bg-primary-container text-on-primary-container"
                : "bg-surface-container-highest text-on-surface-variant",
            ]}
          >
            {row.status}
          </span>
        </div>
        {row.steps.map((step) => (
          <div
            role="cell"
            class="border-t border-outline-variant bg-surface px-4 py-5 text-body-medium text-on-surface-variant"
          >
            {step}
          </div>
        ))}
      </div>
    ))}
  </div>

  <div class="mt-10">
    <div class="flex flex-wrap items-center gap-3">
      <h3 class="text-headline-small text-on-surface">作り方も、磨いていく</h3>
      <span class="rounded-full bg-surface-container-highest px-3 py-1 text-label-medium text-on-surface-variant">
        準備中
      </span>
    </div>
    <p class="mt-4 text-body-large text-on-surface">
      上の PDCA
      は、仕事を回す流れです。その流れの中で成果物の品質を支えるのが、型（Kata）・技（Waza）・流（Ryu）です。いま使える
      register
      を入口に、この三つを組み合わせて成果物づくりを支える仕組みを準備しています。
    </p>

    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      <li class="rounded-large bg-surface-container-low p-5 shadow-elevation-1">
        <h4 class="text-title-large text-on-surface">型（Kata）</h4>
        <p class="mt-3 text-body-medium text-on-surface-variant">
          規約・作り方・完成例・雛形をそろえ、成果物の品質を支えます。何を書き、どう作り、どんな形に仕上げるかの手がかりになります。
        </p>
      </li>
      <li class="rounded-large bg-surface-container-low p-5 shadow-elevation-1">
        <h4 class="text-title-large text-on-surface">技（Waza）</h4>
        <p class="mt-3 text-body-medium text-on-surface-variant">
          記録・実行・評価をつないで、仕事を進めます。register・schedule・routine
          + job は、その仕事の回し方です。
        </p>
      </li>
      <li class="rounded-large bg-surface-container-low p-5 shadow-elevation-1">
        <h4 class="text-title-large text-on-surface">流（Ryu）</h4>
        <p class="mt-3 text-body-medium text-on-surface-variant">
          目的や型の整備状況に合わせて、進め方を選びます。型をどこまで手がかりにして成果物を作るかを決めます。
        </p>
      </li>
    </ul>

    <p class="mt-6 text-body-large text-on-surface">
      仕事を回すだけでなく、作り方も磨いていく。型を整え、技で実行し、目的に合った流れで成果物を育てていきます。
    </p>
  </div>
</section>
