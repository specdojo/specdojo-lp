---
type RegisterType = {
  type: string;
  title: string;
  body: string;
};

type PlanModeComparisonRow = {
  aspect: string;
  planMode: string;
  register: string;
};

// register の 8 種類。最初の一歩として入りやすい todo を先頭にし、先頭の 3 種類を大きく見せる。
// 各説明は pjr-rulebook の item_type 別終端基準と登録簿運用ガイドの種類の表に合わせる。
const primaryRegisterTypes: RegisterType[] = [
  {
    type: "todo",
    title: "やること",
    body: "実施が決まっている作業を、完了条件とやった結果とともに記録します。まずはここから始めます。",
  },
  {
    type: "decision",
    title: "選択肢から方針を決める",
    body: "検討した選択肢、決めたこと、決めた理由と影響を記録します。",
  },
  {
    type: "issue",
    title: "解決すべき問題",
    body: "すでに起きている問題を、解決の内容と確認の結果まで記録します。",
  },
];

const secondaryRegisterTypes: RegisterType[] = [
  {
    type: "epic",
    title: "track ごとの仕事をまとめる",
    body: "具体的な作業は子 todo に分け、epic 自体は実行しません。子項目と schedule を確かめ、人が完了を判断します。",
  },
  {
    type: "question",
    title: "判断を保留し、後で決める",
    body: "回答や確認が必要なことを残し、回答が出たら記録します。",
  },
  {
    type: "risk",
    title: "将来の不確実性",
    body: "まだ起きていない懸念を、消えるか対応を終えるまで追います。",
  },
  {
    type: "change-request",
    title: "合意済みの範囲の変更要求",
    body: "成果物・仕様・計画への変更の要望を、反映と確認まで追います。",
  },
  {
    type: "note",
    title: "記録として残す",
    body: "観測や分析を残します。終わらせず、新しい事実を書き足していきます。",
  },
];

const planModeComparisonRows: PlanModeComparisonRow[] = [
  {
    aspect: "識別",
    planMode: "ランダムな名前。会話の外や後からの参照は難しい",
    register: "PJR-XXXX の恒久的な ID。コミットログや他の文書から追跡可能",
  },
  {
    aspect: "種類",
    planMode: "種別の区別なし（Markdown の自由記述）",
    register:
      "8 つの種別（todo・decision・issue・epic・question・risk・change-request・note）で用途と終わり方を分ける",
  },
  {
    aspect: "状態の遷移",
    planMode: "状態管理なし",
    register:
      "明示的な状態遷移（open・in-progress・waiting・review・done・decided・rejected・deferred）と履歴の記録",
  },
  {
    aspect: "実行の plan・result とのつながり",
    planMode: "実行の plan・result や Git コミットとの体系的な紐付けなし",
    register:
      "specdojo exec の plan・result や統合コミットと紐付いて作業と検証がつながる",
  },
  {
    aspect: "決定の記録",
    planMode: "決定内容や合意の経緯が会話ログに埋もれやすい",
    register: "decision により決めた人・決めた日・承認の方式を確実に記録する",
  },
  {
    aspect: "残り方",
    planMode: "既定では一定期間で消えうる",
    register: "個票としてリポジトリの中に残り、Git の履歴とともに追える",
  },
];
---

<section id="register" class="mt-20">
  <h2 class="text-headline-medium text-on-surface">register の考え方</h2>
  <p class="mt-4 text-body-large text-on-surface">
    register（登録簿）は、プロジェクトで起きたことを 1
    件ずつ起票して記録を集める台帳です。種類は 8 つあります。まずは todo
    から始め、慣れたら decision と issue を使いましょう。
  </p>
  <div class="mt-6 rounded-large bg-secondary-container px-6 py-4">
    <p class="text-label-large text-on-secondary-container">register の 1 周</p>
    <p class="mt-1 text-title-medium text-on-secondary-container">
      記して（P）→ 形にして（D）→ 磨き続ける（C・A）
    </p>
  </div>
  <ul class="mt-6 grid gap-6 md:grid-cols-3">
    {primaryRegisterTypes.map((item) => (
      <li class="rounded-medium bg-surface-container-low p-6 shadow-elevation-1">
        <p class="text-label-large text-primary">{item.type}</p>
        <h3 class="mt-1 text-title-large text-on-surface">{item.title}</h3>
        <p class="mt-2 text-body-medium text-on-surface-variant">{item.body}</p>
      </li>
    ))}
  </ul>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
    {secondaryRegisterTypes.map((item) => (
      <li class="rounded-small bg-surface-container-low p-4">
        <p class="text-label-medium text-primary">{item.type}</p>
        <h3 class="mt-1 text-title-small text-on-surface">{item.title}</h3>
        <p class="mt-1 text-body-small text-on-surface-variant">{item.body}</p>
      </li>
    ))}
  </ul>
  <div class="mt-6 rounded-large bg-secondary-container p-6">
    <ul class="list-disc space-y-2 pl-5 text-body-medium text-on-secondary-container">
      <li>
        起票すると、1 件ごとに個票（Markdown）ができます。個票が記録の正本です。
      </li>
      <li>
        一覧は個票から生成されます。順番のある todo は depends_on（CLI の
        --depends-on）でつなぎ、先行項目が done / decided
        になるまで後続の実行を止めます。
      </li>
      <li>
        個票はただの Markdown なので、SpecDojo がなくても読め、Git
        で履歴を追えます。
      </li>
    </ul>
  </div>

  <div class="mt-12">
    <h3 class="text-title-large text-on-surface">
      plan モードと register の使い分け
    </h3>
    <p class="mt-3 text-body-large text-on-surface">
      register は、1
      件を早く仕上げる道具ではなく、プロジェクトの判断と作業を検証できる形で残し、複数の
      agent に安全に実行させる台帳です。AI ツールの plan
      モードは段取りの下書きとして、register と補い合います。
    </p>

    <ul class="mt-6 space-y-4 md:hidden">
      {planModeComparisonRows.map((row) => (
        <li class="rounded-medium bg-surface-container-low p-5 shadow-elevation-1">
          <dl class="space-y-3">
            <div>
              <dt class="text-label-large text-primary">観点</dt>
              <dd class="mt-1 text-title-medium text-on-surface">
                {row.aspect}
              </dd>
            </div>
            <div>
              <dt class="text-label-large text-on-surface-variant">
                plan モードの plan（下書き）
              </dt>
              <dd class="mt-1 text-body-medium text-on-surface">
                {row.planMode}
              </dd>
            </div>
            <div>
              <dt class="text-label-large text-primary">
                SpecDojo の register（台帳）
              </dt>
              <dd class="mt-1 text-body-medium text-on-surface">
                {row.register}
              </dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>

    <div class="mt-6 hidden overflow-hidden rounded-large border border-outline-variant shadow-elevation-1 md:block">
      <table class="w-full table-fixed text-left">
        <thead class="bg-primary-container text-on-primary-container">
          <tr>
            <th scope="col" class="w-1/5 px-5 py-4 text-label-large">
              観点
            </th>
            <th scope="col" class="w-2/5 px-5 py-4 text-label-large">
              plan モードの plan（下書き）
            </th>
            <th scope="col" class="w-2/5 px-5 py-4 text-label-large">
              SpecDojo の register（台帳）
            </th>
          </tr>
        </thead>
        <tbody class="bg-surface">
          {planModeComparisonRows.map((row) => (
            <tr class="border-t border-outline-variant">
              <td class="px-5 py-4 align-top text-title-small font-semibold text-on-surface">
                {row.aspect}
              </td>
              <td class="px-5 py-4 align-top text-body-medium text-on-surface-variant">
                {row.planMode}
              </td>
              <td class="px-5 py-4 align-top text-body-medium text-on-surface">
                {row.register}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
